# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=api
CORS_ORIGINS=*

# ------------------------------------------------------------------
# Banco de dados (o backend acessa o Postgres pelo nome do serviço Docker)
# ------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=discretionary
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_LOGGING=false
DATABASE_RUN_MIGRATIONS=true
# Porta exposta no host para acessar o Postgres de fora do Docker
DATABASE_EXTERNAL_PORT=5432

# ------------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------------
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------
# Regras de negócio
# ------------------------------------------------------------------
# Percentual do VLRTEORICO total do grupo que compõe o pool (1%)
POOL_PERCENTUAL=0.01
# Limite absoluto do discricionário (15pp = 0.15)
LIMITE_DISCRICIONARIO=0.15
UPLOAD_MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------
# pgAdmin
# ------------------------------------------------------------------
PGADMIN_EMAIL=admin@discricionario.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ------------------------------------------------------------------
# Seed
# ------------------------------------------------------------------
SEED_SENHA_PADRAO=Senha@123
SEED_QTD_PARTICIPANTES=1500
