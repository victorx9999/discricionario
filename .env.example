# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=*

# ------------------------------------------------------------------
# Banco de dados (o backend acessa o Postgres pelo nome do serviço Docker)
# ------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=discretionary
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_LOGGING=false
DATABASE_RUN_MIGRATIONS=true
# Porta exposta no host para acessar o Postgres de fora do Docker
DATABASE_EXTERNAL_PORT=5432

# ------------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------------
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------
# Premissas PADRÃO de novos ciclos
# Cada ciclo guarda as suas próprias premissas (tabela `ciclos`);
# estes valores só definem como um ciclo novo nasce.
# ------------------------------------------------------------------
# Percentual do VLR_TEORICO que compõe o pool (1%)
POOL_PERCENTUAL=0.01
# Limite do FD (15pp = 0.15)
LIMITE_DISCRICIONARIO=0.15
UPLOAD_MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------
# pgAdmin
# ------------------------------------------------------------------
PGADMIN_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------
FRONTEND_PORT=4200

# ------------------------------------------------------------------
# Seed
# ------------------------------------------------------------------
SEED_SENHA_PADRAO=Senha@123
SEED_QTD_PARTICIPANTES=1200
# Anos gerados pelo seed. O último fica ativo; os anteriores, fechados.
SEED_ANOS=2025,2026
